# Copy to `.env` and fill what you have. Empty values are honest: the code
# falls back to a clearly labelled local/simulated path instead of pretending.
# Never commit `.env`. Never put a FullAccess key in NEAR_AGENT_KEY.

# NEAR
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=
# Limited Function Call Key for the agent (NOT full access). Format: ed25519:...
# It must be scoped to POLICY_CONTRACT_ID and to the `try_pay` method only.
NEAR_AGENT_KEY=
# Contract account holding the policy:
POLICY_CONTRACT_ID=

# NEAR AI Cloud (the OpenAI-compatible gateway host, not the dashboard host)
NEAR_AI_CLOUD_API_KEY=
NEAR_AI_CLOUD_BASE_URL=https://cloud-api.near.ai
# Must be a Confidential / TEE-tier model ID from https://docs.near.ai/cloud/models
NEAR_AI_CLOUD_MODEL=

# Intents (testnet)
INTENTS_API_URL=
INTENTS_ASSET_USDC_TESTNET=

# Demo policy defaults
DAILY_CAP_USDC=10
WHITELIST_RECIPIENT=alice.testnet
